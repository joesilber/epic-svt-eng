# Build outputs (use /* so children can be whitelisted below)
bin/*
obj/

# Whitelist only the Release executable - everything else stays ignored
!bin/Release/
bin/Release/*
!bin/Release/net48/
bin/Release/net48/*
!bin/Release/net48/PatternTool.exe

# SOLIDWORKS lock files (leftover when a document was open or a session crashed)
~$*
